# Application environment: development, testing, or production.
FLASK_ENV=development

# Required in production. Use a strong, unique value outside version control.
SECRET_KEY=replace-with-a-secure-random-value

# PostgreSQL connection strings used by SQLAlchemy.
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/recipe_sharing
TEST_DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/recipe_sharing_test

# Required to explicitly authorize database tests against TEST_DATABASE_URL.
RUN_DATABASE_TESTS=0

# Development seed credentials only. Never use these defaults in production.
# SEED_ADMIN_PASSWORD=replace-development-password
# SEED_MODERATOR_PASSWORD=replace-development-password
# SEED_USER_PASSWORD=replace-development-password
