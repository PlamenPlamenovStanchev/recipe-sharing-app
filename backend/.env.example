# Runtime
FLASK_ENV=production
HOST=0.0.0.0
PORT=8000

# Application secrets (replace with strong, independent values)
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# Neon or another PostgreSQL provider; keep TLS enabled in production
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Exact deployed frontend origin; never use * in production
FRONTEND_ORIGIN=https://example.netlify.app

# Private AWS S3 recipe image storage
AWS_ACCESS_KEY_ID=replace-with-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-access-key
AWS_REGION=eu-central-1
AWS_S3_BUCKET_NAME=replace-with-private-bucket-name
AWS_S3_PRESIGNED_URL_EXPIRATION=3600

# AWS SES welcome email delivery
AWS_SES_REGION=eu-central-1
AWS_SES_SENDER_EMAIL=verified-sender@example.com

# Payment provider abstraction; real Wise calls remain pending implementation
PAYMENT_PROVIDER=wise
WISE_API_TOKEN=replace-when-real-wise-integration-is-implemented
WISE_PROFILE_ID=replace-when-real-wise-integration-is-implemented

# Test-only settings; do not point these at the production database
TEST_DATABASE_URL=postgresql://TEST_USER:TEST_PASSWORD@TEST_HOST/TEST_DATABASE
RUN_DATABASE_TESTS=0
