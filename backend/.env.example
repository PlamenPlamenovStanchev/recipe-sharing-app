# Application environment: development, testing, or production.
FLASK_ENV='<put your environment here>'

# Required in production. Use a strong, unique value outside version control.
SECRET_KEY='<put your secret key here>'

# JWT signing key and lifetime. Use a separate strong key in production.
JWT_SECRET_KEY='<put your JWT secret key here>' 
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# PostgreSQL connection strings used by SQLAlchemy.
DATABASE_URL='<put your database connection string here>'
TEST_DATABASE_URL='<put your test database connection string here>'

# Required to explicitly authorize database tests against TEST_DATABASE_URL.
RUN_DATABASE_TESTS=0

# AWS S3 configuration for file uploads. Use your own credentials and bucket name.
AWS_ACCESS_KEY_ID='<put your AWS access key ID here>'
AWS_SECRET_ACCESS_KEY='<put your AWS secret access key here>'
AWS_REGION='<put your AWS region here>'
AWS_S3_BUCKET_NAME='<put your AWS S3 bucket name here>'
# Lifetime, in seconds, of private S3 image URLs returned by the API.
AWS_S3_PRESIGNED_URL_EXPIRATION=3600

# AWS SES configuration for sending emails. Use your own credentials and verified sender email.
AWS_SES_REGION='<put your AWS SES region here>'
AWS_SES_SENDER_EMAIL='<put your AWS SES sender email here>'

# Payment provider selection. Real Wise API calls are not implemented yet.
PAYMENT_PROVIDER=wise
# WISE_API_TOKEN='<configure when the Wise integration is implemented>'
# WISE_PROFILE_ID='<configure when the Wise integration is implemented>'
